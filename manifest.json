{
  "name": "Devanāgarī Converter",
  "action": {},
  "manifest_version": 3,
  "version": "0.1",
  "description": "Convert Indian scripts to Devanāgarī",
  "permissions": ["activeTab", "scripting"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "host_permissions": [
  "<all_urls>"
]
}
